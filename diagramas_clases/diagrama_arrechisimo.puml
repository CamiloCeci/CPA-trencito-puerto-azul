@startuml TrencitoPuertoAzul_MasterBlueprint
!theme plain
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 50
skinparam ranksep 80
skinparam linetype ortho
skinparam class {
    BackgroundColor White
    BorderColor Black
}

'Hardware'
 class CoordenadasGps_Python <<Python Script>> {
        - TX_PIN: int = 11
        - RX_PIN: int = 10
        - PWRKEY_PIN: int = 18
        - POWERON_PIN: int = 12
        - RESET_PIN: int = 17
        - DTR_PIN: int = 9
        - BAUD: int = 115200
        - uart: machine.UART
        + _init_(uart_id: int, timeout: int)
        - _ts(): String
        + log(msg: String): void
        - _flush_uart(): void
        - _read_uart(wait_ms: int, quiet_ms: int): String
        + send_at(cmd: String, wait_ms: int): String
        + boot_factory_like(): void
        + sync_modem(): boolean
        + init_gnss_factory_sequence(): void
        + parse_gps(raw: String): Map
        + auto_cycle(): tuple
        + http_get_coords(coords: tuple): void
        + initialize(): boolean
        + run_auto_cycle(interval: int): void
    }

    CoordenadasGps_Python ..> CoordenadaGpsController : <<HTTP GET /api/gps/{lat}/{lon}>>
    Tren "1" o-- "1" CoordenadasGps_Python : <<Contiene Hardware Físico>>
' ==========================================
' 1. MODELO DE DOMINIO Y ENTIDADES (JPA)
' ==========================================


    abstract class Usuario {
        # id: Long
        # cedula: String
        # clave: String
        # rol: Rol
        + Usuario()
        + Usuario(cedula: String, clave: String)
        + Usuario(id: Long, cedula: String, clave: String, rol: Rol)
        + getId(): Long
        + setId(id: Long): void
        + getCedula(): String
        + setCedula(cedula: String): void
        + getClave(): String
        + setClave(clave: String): void
        + getRol(): Rol
        + setRol(rol: Rol): void
    }

    enum Rol <<Enum>> {
        SOCIO
        VIP
        OPERADOR
        ADMINISTRADOR
    }

    class Socio {
        - colaVirtual: ColaVirtual
        + Socio()
        + Socio(id: Long, cedula: String, clave: String)
        + getColaVirtual(): ColaVirtual
        + setColaVirtual(colaVirtual: ColaVirtual): void
        + getIdEstacionActual(): Long
        + isEsperando(): boolean
    }

    class VIP {
        + VIP()
        + VIP(id: Long, cedula: String, clave: String)
    }

    class Operador {
        + Operador()
        + Operador(id: Long, cedula: String, clave: String)
    }

    class Administrador {
        + Administrador()
        + Administrador(id: Long, cedula: String, clave: String)
    }

    class Estacion {
        - id: Long
        - nombre: String
        - contadorPersonasEnCola: int
        - latitude: double
        - longitude: double
        + Estacion()
        + Estacion(id: Long, nombre: String, latitude: double, longitude: double)
        + getNombre(): String
        + setNombre(nombre: String): void
        + getId(): Long
        + setId(id: Long): void
        + getContador(): int
        + getLatitude(): double
        + getLongitude(): double
        + subirContador(): void
        + bajarContador(): void
    }

    class ColaVirtual {
        - id: Long
        - socio: Socio
        - estacion: Estacion
        + ColaVirtual()
        + ColaVirtual(socio: Socio, estacion: Estacion)
        + getId(): Long
        + setId(id: Long): void
        + getSocio(): Socio
        + setSocio(socio: Socio): void
        + getEstacion(): Estacion
        + setEstacion(estacion: Estacion): void
        + isEsperando(): boolean
    }

    class Tren {
        - capMax: int = 20
        - puestosLibres: int
        + Tren(puestosLibres: int)
        + getCapMax(): int
        + getPuestosLibres(): int
        + setPuestosLlenos(puestosLlenos: int): boolean
        + aumentarPuestosLlenos(): boolean
        + disminuirPuestosLlenos(): boolean
    }

    class CoordenadaGps {
        - id: long
        - latitude: double
        - longitude: double
        - speed: double
        - timestamp: LocalDateTime
        + CoordenadaGps()
        + CoordenadaGps(latitude: double, longitude: double)
        + CoordenadaGps(latitude: double, longitude: double, speed: double)
        + CoordenadaGps(id: long, latitude: double, longitude: double, speed: double, timestamp: LocalDateTime)
        + getId(): long
        + getLatitude(): double
        + setLatitude(latitude: double): void
        + getLongitude(): double
        + setLongitude(longitude: double): void
        + getSpeed(): double
        + setSpeed(speed: double): void
        + getTimestamp(): LocalDateTime
        + setTimestamp(timestamp: LocalDateTime): void
